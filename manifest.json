{
  "manifest_version": 3,
  "name": "Dev by Sugeng - Auto Quest Extension",
  "version": "5.1.1",
  "description": "Discord Auto Quest Extension by Sugeng.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "activeTab",
    "storage",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://keyauth.win/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*"
      ],
      "js": [
        "scripts/user-agent-check.js",
        "scripts/get-uid.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://discord.com/quest-home*"
      ],
      "js": [
        "scripts/keyauth-config.js",
        "scripts/keyauth-client.js",
        "scripts/quest-home.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/quest-code.js",
        "scripts/get-quests-list.js",
        "assets/notif.wav"
      ],
      "matches": [
        "*://discord.com/*"
      ]
    }
  ]
}